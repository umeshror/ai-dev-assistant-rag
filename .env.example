# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Environment variable template
# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env
#   # then edit .env
#
# IMPORTANT: Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your OpenAI API key. Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=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

# ── OpenAI Models ─────────────────────────────────────────────────────────────

# Embedding model used for policy indexing and query embedding
EMBEDDING_MODEL=text-embedding-3-small

# Chat completion model used for analysis
CHAT_MODEL=gpt-4o

# ── RAG / Retrieval ────────────────────────────────────────────────────────────

# Number of policy chunks to retrieve per query
TOP_K=5

# Path to the FAISS index directory (relative to project root)
FAISS_INDEX_PATH=./data/faiss_index

# Path to the raw policies text file
POLICIES_FILE_PATH=./data/policies.txt

# ── LLM Configuration ─────────────────────────────────────────────────────────

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# Maximum tokens in LLM response
LLM_MAX_TOKENS=1024

# HTTP timeout for LLM API calls (seconds)
LLM_TIMEOUT_SECONDS=30

# Max retry attempts for transient LLM errors
LLM_MAX_RETRIES=3

# ── Logging ────────────────────────────────────────────────────────────────────

# Root logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Application ────────────────────────────────────────────────────────────────

APP_NAME=AI Developer Assistant
APP_VERSION=1.0.0

# Deployment environment: development | staging | production
ENVIRONMENT=development
